# ─────────────────────────────────────────────────────────────────
# Divine Conductor AI — Environment Variables Template
#
# Copy this file to .env and fill in your credentials.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── Stripe (Subscription Gate) ─────────────────────────────────────
# Publishable and secret keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret from the Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# URL that Stripe redirects users to after a successful checkout
STRIPE_SUCCESS_URL=http://localhost:8000/checkout/success
# URL that Stripe redirects users to after a cancelled checkout
STRIPE_CANCEL_URL=http://localhost:8000/checkout/cancel

# ── Video generation APIs ──────────────────────────────────────────
# Google Veo API key (https://ai.google.dev)
VEO_API_KEY=
# OpenAI Sora API key (https://platform.openai.com)
SORA_API_KEY=

# ── Application ───────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Directory where pipeline artefacts are written
OUTPUT_DIR=/app/output
